{
  "name": "social-hub",
  "version": "0.1.1",
  "tablePrefix": "shub_",
  "description": "Connect your Facebook Page and LinkedIn Page, see what you have already posted on both, and write, schedule and publish new posts with pictures and link previews from one place.",
  "requiresCoreVersion": "0.5.1779",
  "permissions": [
    "socialhub.view",
    "socialhub.post",
    "socialhub.manage"
  ],
  "navEntries": [
    {
      "label": "Social Hub",
      "path": "/m/social-hub",
      "icon": "<path d=\"M4 11v3a1 1 0 0 0 1 1h2l5 4V6L7 10H5a1 1 0 0 0-1 1z\"/><path d=\"M16 9a4 4 0 0 1 0 6\"/><path d=\"M18.5 6.5a8 8 0 0 1 0 11\"/>",
      "permission": "socialhub.view"
    }
  ],
  "requiredEnvVars": [
    {
      "name": "ENCRYPTION_KEY",
      "required": true
    }
  ],
  "cookieCategories": [],
  "requiresModules": [],
  "cronJobs": [
    {
      "path": "/api/m/social-hub/cron/publish",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/m/social-hub/cron/sync",
      "schedule": "25 * * * *"
    }
  ],
  "settingsTabs": [
    {
      "id": "social-hub",
      "label": "Social Hub",
      "permission": "socialhub.manage",
      "import": "./components/admin/SettingsTab",
      "component": "SocialHubSettingsTab"
    }
  ],
  "teardown": [
    "shub_remote_posts",
    "shub_post_targets",
    "shub_posts",
    "shub_connections",
    "shub_settings"
  ]
}
