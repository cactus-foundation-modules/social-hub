{
  "name": "social-hub",
  "version": "0.1.16",
  "tablePrefix": "shub_",
  "notificationKinds": [
    {"id": "attention", "label": "Social Hub needs attention", "description": "A connected account, post or schedule needs a look.", "dedupePrefix": "social-hub:attention"}
  ],
  "description": "Connect your Facebook Page and LinkedIn Page, see what you have already posted on both, and write, schedule and publish new posts with pictures and link previews from one place.",
  "requiresCoreVersion": "0.5.1779",
  "permissions": [
    "socialhub.view",
    "socialhub.post",
    "socialhub.manage"
  ],
  "navEntries": [
    {
      "label": "Social Hub",
      "path": "/m/social-hub",
      "icon": "<circle cx=\"18\" cy=\"5\" r=\"3\"/><circle cx=\"6\" cy=\"12\" r=\"3\"/><circle cx=\"18\" cy=\"19\" r=\"3\"/><path d=\"M8.6 13.5l6.8 4M15.4 6.5l-6.8 4\"/>",
      "permission": "socialhub.view"
    }
  ],
  "requiredEnvVars": [
    {
      "name": "ENCRYPTION_KEY",
      "required": true
    }
  ],
  "cookieCategories": [],
  "requiresModules": [],
  "extensionPoints": [
    {
      "point": "gazette.admin-tabs",
      "id": "social-posts",
      "label": "Social posts",
      "order": 50,
      "permission": "socialhub.view",
      "import": "./components/admin/GazetteSocialTab",
      "component": "GazetteSocialTab"
    },
    {
      "point": "gazette.post-editor-panels",
      "id": "social-share",
      "label": "Share on social media",
      "order": 10,
      "permission": "socialhub.view",
      "import": "./components/admin/GazetteSharePanel",
      "component": "GazetteSharePanel"
    },
    {
      "point": "gazette.post-status-changed",
      "id": "social-hub",
      "import": "./lib/gazette-follow",
      "component": "socialHubGazettePostStatus",
      "serverOnly": true
    }
  ],
  "cronJobs": [
    {
      "path": "/api/m/social-hub/cron/publish",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/m/social-hub/cron/sync",
      "schedule": "25 * * * *"
    }
  ],
  "settingsTabs": [
    {
      "id": "social-hub",
      "label": "Social Hub",
      "permission": "socialhub.manage",
      "import": "./components/admin/SettingsTab",
      "component": "SocialHubSettingsTab"
    }
  ],
  "teardown": [
    "shub_remote_posts",
    "shub_post_targets",
    "shub_posts",
    "shub_connections",
    "shub_settings"
  ]
}
